// Prisma schema for Student Accommodation Management System
// NSFAS-compliant, ISO 27001 & SOC 2 compliant

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "sqlite" // Can be changed to "postgresql" for production
  url      = env("DATABASE_URL")
}

// ================================================================
// Core Entities
// ================================================================

model Property {
  id                    String   @id @default(cuid())
  name                  String
  address               String
  city                  String
  province              String
  postalCode            String
  totalBeds             Int
  availableBeds         Int      @default(0)
  nsfasAccredited       Boolean  @default(false)
  accreditationNumber   String?
  accreditationExpiry   DateTime?
  contactPerson         String
  contactEmail          String
  contactPhone          String
  latitude              Float?
  longitude             Float?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  rooms                 Room[]
  leases                Lease[]
  students              Student[]
  accessLogs            AccessLog[]
  maintenanceRequests   MaintenanceRequest[]
  nsfasCompliance       NsfasCompliance[]
  facilities            Facility[]
  notices               Notice[]
  laundryMachines       LaundryMachine[]
  wifiAccessPoints      WifiAccessPoint[]
  kioskProducts         KioskProduct[]

  @@index([nsfasAccredited])
  @@map("properties")
}

model Room {
  id                String   @id @default(cuid())
  propertyId        String
  roomNumber        String
  floor             Int
  roomType          String   // single, shared, studio
  sizeSquareMeters  Float
  maxOccupancy      Int
  currentOccupancy  Int      @default(0)
  monthlyRate       Float
  availableFrom     DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases            Lease[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId])
  @@index([availableFrom])
  @@map("rooms")
}

model Student {
  id                    String   @id @default(cuid())
  studentNumber         String   @unique
  firstName             String
  lastName              String
  email                 String   @unique
  phone                 String
  dateOfBirth           DateTime
  idNumber              String   @unique

  // NSFAS eligibility
  nsfasBeneficiary      Boolean  @default(false)
  nsfasApproved         Boolean  @default(false)
  nsfasReference        String?

  // University info
  universityName        String
  universityDistance    Float?   // Distance in km
  courseOfStudy         String
  yearOfStudy           Int

  // Emergency contact
  emergencyContactName  String
  emergencyContactPhone String
  emergencyRelationship String

  // Address
  homeAddress           String
  homeCity              String
  homeProvince          String
  homePostalCode        String

  // Account
  propertyId            String?
  accountStatus         String   @default("active") // active, suspended, inactive

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  property              Property? @relation(fields: [propertyId], references: [id])
  leases                Lease[]
  accessLogs            AccessLog[]
  maintenanceRequests   MaintenanceRequest[]
  studentBursaries      StudentBursary[]
  residenceVerifications ResidenceVerification[]
  academicRecords       AcademicRecord[]
  conductRecords        ConductRecord[]
  laundryBookings       LaundryBooking[]
  visitorRegistrations  VisitorRegistration[]
  complaints            Complaint[]
  kioskOrders           KioskOrder[]
  deliveries            ParcelDelivery[]
  sessions              Session[]
  accounts              Account[]

  @@index([studentNumber])
  @@index([email])
  @@index([nsfasBeneficiary])
  @@index([propertyId])
  @@map("students")
}

model Lease {
  id                String   @id @default(cuid())
  studentId         String
  propertyId        String
  roomId            String

  startDate         DateTime
  endDate           DateTime
  monthlyRent       Float
  securityDeposit   Float
  leaseStatus       String   @default("active") // active, expired, terminated

  // NSFAS compliance
  nsfasFunded       Boolean  @default(false)
  nsfasAmount       Float?
  withinNsfasCap    Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@index([studentId])
  @@index([propertyId])
  @@index([roomId])
  @@index([leaseStatus])
  @@index([endDate])
  @@map("leases")
}

// ================================================================
// Bursary Management
// ================================================================

model BursaryProvider {
  id                  String   @id @default(cuid())
  name                String   @unique
  type                String   // government, corporate, ngo, university, private, other
  contactPerson       String?
  contactEmail        String?
  contactPhone        String?
  requirements        String?  // JSON: list of requirements
  reportingFrequency  String   @default("monthly") // weekly, monthly, quarterly, semester, annual
  reportTemplate      String?  // JSON: template configuration
  isActive            Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  studentBursaries    StudentBursary[]
  bursaryReports      BursaryReport[]
  requirements_rel    BursaryRequirement[]

  @@index([isActive])
  @@map("bursary_providers")
}

model BursaryRequirement {
  id                  String   @id @default(cuid())
  providerId          String
  name                String
  description         String?
  type                String   // attendance, academic, conduct, financial
  isMandatory         Boolean  @default(true)
  frequency           String   // daily, weekly, monthly, semester, annual
  thresholdValue      String?  // JSON: threshold configuration

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  provider            BursaryProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("bursary_requirements")
}

model StudentBursary {
  id                  String   @id @default(cuid())
  studentId           String
  providerId          String
  bursaryReference    String   @unique
  amount              Float
  currency            String   @default("ZAR")
  academicYear        String
  startDate           DateTime
  endDate             DateTime
  status              String   @default("active") // pending, active, suspended, completed, cancelled
  conditions          String?  // JSON: specific conditions
  paymentSchedule     String?  // JSON: payment schedule/milestones

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  provider            BursaryProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  complianceAlerts    BursaryComplianceAlert[]

  @@index([studentId])
  @@index([providerId])
  @@index([status])
  @@index([academicYear])
  @@map("student_bursaries")
}

model ResidenceVerification {
  id                  String   @id @default(cuid())
  studentId           String
  propertyId          String
  verificationDate    DateTime
  verificationType    String   // checkin, weekly, monthly, random, audit
  verifiedBy          String?
  verificationMethod  String   // physical, biometric, access_log, photo, video, other
  isPresent           Boolean
  notes               String?
  evidenceUrl         String?

  createdAt           DateTime @default(now())

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([verificationDate])
  @@index([isPresent])
  @@map("residence_verifications")
}

model AcademicRecord {
  id                  String   @id @default(cuid())
  studentId           String
  academicYear        String
  semester            String
  courseName          String
  courseCode          String
  credits             Int
  grade               String?
  percentage          Float?
  status              String   // passed, failed, pending, incomplete
  submittedDate       DateTime

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([academicYear])
  @@map("academic_records")
}

model ConductRecord {
  id                  String   @id @default(cuid())
  studentId           String
  incidentDate        DateTime
  incidentType        String   // noise, damage, violation, dispute, other
  severity            String   // minor, moderate, serious, critical
  description         String
  actionTaken         String?
  resolution          String?
  affectsBursary      Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([incidentDate])
  @@index([affectsBursary])
  @@map("conduct_records")
}

model BursaryReport {
  id                  String   @id @default(cuid())
  providerId          String
  reportPeriodStart   DateTime
  reportPeriodEnd     DateTime
  reportType          String   // individual, aggregate, compliance, financial, custom
  status              String   @default("draft") // draft, pending_review, approved, sent, archived
  totalStudents       Int?
  compliantStudents   Int?
  nonCompliantStudents Int?
  reportData          String?  // JSON: detailed report data
  generatedBy         String?
  approvedBy          String?
  sentAt              DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  provider            BursaryProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  studentData         ReportStudentData[]
  accessLogs          ReportAccessLog[]

  @@index([providerId])
  @@index([status])
  @@index([reportPeriodStart, reportPeriodEnd])
  @@map("bursary_reports")
}

model ReportStudentData {
  id                  String   @id @default(cuid())
  reportId            String
  studentId           String
  complianceStatus    String   // compliant, warning, non_compliant
  attendanceRate      Float
  residenceVerified   Boolean
  academicStatus      String
  conductStatus       String
  issuesCount         Int      @default(0)
  metricsData         String?  // JSON: detailed metrics
  recommendations     String?

  createdAt           DateTime @default(now())

  // Relations
  report              BursaryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_student_data")
}

model BursaryComplianceAlert {
  id                  String   @id @default(cuid())
  studentId           String
  bursaryId           String
  alertType           String   // residence, academic, conduct, payment, document
  severity            String   // info, warning, critical
  title               String
  description         String
  status              String   @default("open") // open, acknowledged, resolved, escalated
  acknowledgedBy      String?
  acknowledgedAt      DateTime?
  resolvedBy          String?
  resolvedAt          DateTime?
  resolutionNotes     String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  bursary             StudentBursary @relation(fields: [bursaryId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([bursaryId])
  @@index([status])
  @@index([severity])
  @@map("bursary_compliance_alerts")
}

model ReportAccessLog {
  id                  String   @id @default(cuid())
  reportId            String
  accessedBy          String
  accessMethod        String   // view, download, export
  ipAddress           String?
  userAgent           String?
  accessedAt          DateTime @default(now())

  // Relations
  report              BursaryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([accessedAt])
  @@map("report_access_logs")
}

// ================================================================
// Student Portal
// ================================================================

model Notice {
  id                  String   @id @default(cuid())
  propertyId          String
  title               String
  content             String
  category            String   // general, maintenance, event, urgent
  priority            String   @default("normal") // low, normal, high, urgent
  isActive            Boolean  @default(true)
  publishDate         DateTime @default(now())
  expiryDate          DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([isActive])
  @@index([publishDate])
  @@map("notices")
}

model LaundryMachine {
  id                  String   @id @default(cuid())
  propertyId          String
  machineNumber       String
  machineType         String   // washer, dryer
  status              String   @default("available") // available, in_use, maintenance, out_of_order
  lastMaintenance     DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings            LaundryBooking[]

  @@unique([propertyId, machineNumber])
  @@index([propertyId])
  @@index([status])
  @@map("laundry_machines")
}

model LaundryBooking {
  id                  String   @id @default(cuid())
  studentId           String
  machineId           String
  bookingDate         DateTime
  startTime           DateTime
  endTime             DateTime
  status              String   @default("scheduled") // scheduled, active, completed, cancelled

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  machine             LaundryMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([machineId])
  @@index([bookingDate])
  @@index([status])
  @@map("laundry_bookings")
}

model VisitorRegistration {
  id                  String   @id @default(cuid())
  studentId           String
  visitorName         String
  visitorIdNumber     String
  visitorPhone        String
  visitDate           DateTime
  visitPurpose        String
  checkInTime         DateTime?
  checkOutTime        DateTime?
  status              String   @default("pending") // pending, checked_in, checked_out, cancelled

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([visitDate])
  @@index([status])
  @@map("visitor_registrations")
}

model Complaint {
  id                  String   @id @default(cuid())
  studentId           String
  category            String   // accommodation, maintenance, staff, security, other
  subject             String
  description         String
  priority            String   @default("normal") // low, normal, high, urgent
  status              String   @default("open") // open, in_progress, resolved, closed
  assignedTo          String?
  resolution          String?
  resolvedAt          DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([priority])
  @@map("complaints")
}

model KioskProduct {
  id                  String   @id @default(cuid())
  propertyId          String
  name                String
  description         String?
  category            String   // snacks, beverages, toiletries, stationery, other
  price               Float
  stockQuantity       Int      @default(0)
  isAvailable         Boolean  @default(true)
  imageUrl            String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  orderItems          KioskOrderItem[]

  @@index([propertyId])
  @@index([isAvailable])
  @@map("kiosk_products")
}

model KioskOrder {
  id                  String   @id @default(cuid())
  studentId           String
  totalAmount         Float
  status              String   @default("pending") // pending, confirmed, completed, cancelled
  paymentMethod       String?  // cash, card, account
  paymentStatus       String   @default("pending") // pending, paid, refunded

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items               KioskOrderItem[]

  @@index([studentId])
  @@index([status])
  @@map("kiosk_orders")
}

model KioskOrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String
  quantity            Int
  priceAtTime         Float

  createdAt           DateTime @default(now())

  // Relations
  order               KioskOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             KioskProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("kiosk_order_items")
}

model WifiAccessPoint {
  id                  String   @id @default(cuid())
  propertyId          String
  ssid                String
  password            String
  location            String
  isActive            Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("wifi_access_points")
}

model ParcelDelivery {
  id                  String   @id @default(cuid())
  studentId           String
  trackingNumber      String   @unique
  courier             String
  deliveredAt         DateTime
  collectedAt         DateTime?
  status              String   @default("pending") // pending, collected, returned
  notes               String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([trackingNumber])
  @@map("parcel_deliveries")
}

// ================================================================
// Core Features
// ================================================================

model AccessLog {
  id                  String   @id @default(cuid())
  studentId           String
  propertyId          String
  accessType          String   // entry, exit
  accessMethod        String   // key_card, pin, biometric, manual
  accessPoint         String?
  wasGranted          Boolean  @default(true)
  denialReason        String?
  timestamp           DateTime @default(now())

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([propertyId])
  @@index([timestamp])
  @@map("access_logs")
}

model MaintenanceRequest {
  id                  String   @id @default(cuid())
  studentId           String?
  propertyId          String
  category            String   // plumbing, electrical, appliance, structural, cleaning, other
  subcategory         String?
  priority            String   @default("normal") // low, normal, high, urgent
  status              String   @default("open") // open, assigned, in_progress, completed, closed
  title               String
  description         String
  location            String?
  assignedTo          String?
  estimatedCost       Float?
  actualCost          Float?
  completedAt         DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student             Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@map("maintenance_requests")
}

model NsfasCompliance {
  id                  String   @id @default(cuid())
  propertyId          String
  requirementCategory String   // documentation, health_safety, facilities, room_specs, security
  requirementName     String
  status              String   @default("pending") // pending, compliant, non_compliant
  notes               String?
  evidenceUrl         String?
  lastChecked         DateTime?
  nextReviewDate      DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
  @@map("nsfas_compliance")
}

model Facility {
  id                  String   @id @default(cuid())
  propertyId          String
  facilityType        String   // sink, shower, toilet, kitchen, laundry
  quantity            Int
  condition           String   @default("good") // excellent, good, fair, poor
  lastInspection      DateTime?
  nextInspection      DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([facilityType])
  @@map("facilities")
}

model Payment {
  id                  String   @id @default(cuid())
  leaseId             String
  amount              Float
  paymentDate         DateTime
  paymentMethod       String   // cash, card, eft, nsfas
  paymentReference    String?
  paymentStatus       String   @default("completed") // pending, completed, failed, refunded
  description         String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  lease               Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId])
  @@index([paymentDate])
  @@index([paymentStatus])
  @@map("payments")
}

// ================================================================
// Authentication (NextAuth.js)
// ================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              Student @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         Student  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ================================================================
// Audit & Compliance
// ================================================================

model AuditLog {
  id                  String   @id @default(cuid())
  userId              String?
  action              String   // CREATE, READ, UPDATE, DELETE
  resource            String   // table/entity name
  resourceId          String?
  changes             String?  // JSON: before/after values
  ipAddress           String?
  userAgent           String?
  timestamp           DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([timestamp])
  @@map("audit_logs")
}
